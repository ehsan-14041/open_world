{
 "id": "us_manufacturing_backlog",
 "title": "US manufacturing unfilled orders excluding transportation, 2018-2024",
 "definition": "Monthly unfilled orders (backlog) and value of shipments for US manufacturing EXCLUDING transportation equipment, with Federal Reserve manufacturing capacity utilisation as an independently measured pressure variable.",
 "why_excluding_transportation": "Transportation equipment (chiefly aircraft) is about 59% of total manufacturing unfilled orders and carries a multi-year order-book cycle unrelated to supply disruption. Including it would swamp the dynamic under test.",
 "pressure_variable": "capacity_utilisation_pct",
 "series_ids": {
  "unfilled_orders_musd": "AMXTUO",
  "shipments_musd": "AMXTVS",
  "capacity_utilisation_pct": "MCUMFN"
 },
 "sources": [
  "fred_amxtuo",
  "fred_amxtvs",
  "fred_mcumfn"
 ],
 "circularity_warning": "US Census M3 DERIVES New Orders as Shipments + change in Unfilled Orders. New Orders is therefore NOT an independent driver for this test and is deliberately excluded. Capacity utilisation is measured separately by the Federal Reserve (G.17) and is used as the pressure variable instead.",
 "limitations": [
  "NATIONAL AGGREGATE. The model's order_backlog is a node-level, disruption-specific backlog; aggregating across all industries averages together sectors that are accumulating and sectors that are draining, which attenuates exactly the dynamic under test. This test is therefore UNDERPOWERED for a node-level claim.",
  "Backlog cover (backlog / shipments) has a secular upward trend across the window; any matched-pressure comparison must be detrended or it measures trend rather than hysteresis.",
  "The April 2020 cover spike is a denominator artefact: shipments fell about 19% while backlog was flat, so cover rose without any accumulation.",
  "One capacity-utilisation cycle is available in the window, giving small matched-pressure samples."
 ],
