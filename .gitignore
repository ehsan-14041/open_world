.env

# Stray / build artifacts
owe.zip
=*
# Runtime outputs
data/feedback/
data/snapshots/last_snapshot.json

# Runtime decision-journal / ensemble outputs
output/

# Downloaded external datasets (public, fetched on demand)
data/external/*

# ...except frozen anchorage geometry. It is small, it is the *definition* of the AIS
# measurement rather than an observation, and the ANTAQ round showed why a frozen artifact
# must not depend on an external service staying reachable: the endpoint the Brazilian
# federal catalog designated for that dataset is now NXDOMAIN.
!data/external/ais/
!data/external/ais/*
!data/external/ais/geometry/
!data/external/ais/geometry/*.json

# AIS regional extracts and per-day download receipts ARE tracked. They are ~100MB, which is
# a lot for a repo — but they are the distilled product of 17.1GB of national AIS transfer,
# and without them reproducing the Hampton Roads baseline means a 34-minute, 17GB download.
# Each extract is a filtered slice of one national daily file whose SHA-256 is recorded in
# metadata/, so the provenance chain back to NOAA stays verifiable.
!data/external/ais/daily/
!data/external/ais/daily/*.csv
!data/external/ais/metadata/
!data/external/ais/metadata/*.json

# The national archives themselves are never kept: ~284MB each, streamed and deleted.
data/external/ais/national/
